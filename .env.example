# FUNBOARD Environment Configuration
# Copy this file to .env for local environment overrides

# HTTP Server Port (Render automatically sets this in production)
PORT=3000

# Server Host binding (0.0.0.0 is recommended for container/cloud environments)
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# SQLite Database Location
# Default: ./data/whiteboard.db (relative to project root)
# If using a Render Persistent Disk mounted at /var/data:
# DB_PATH=/var/data/whiteboard.db
DB_PATH=
